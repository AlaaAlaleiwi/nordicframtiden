# Copy this file to .env for local Docker Compose usage.
# Never commit .env or fill real secrets into this example.

# API datasource. For the bundled PostgreSQL container, keep host `db`.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/nordicframtiden
SPRING_DATASOURCE_USERNAME=nordic
SPRING_DATASOURCE_PASSWORD=

# Generate at least 32 random bytes; do not reuse this value across environments.
APP_JWT_SECRET=

# Bundled PostgreSQL container.
POSTGRES_DB=nordicframtiden
POSTGRES_USER=nordic
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Optional JWT settings.
APP_JWT_EXPIRES_MIN=15
APP_JWT_ISSUER=nordicframtiden

# Optional mail settings. MAIL_PASSWORD is runtime-only and must be supplied by
# the deployment environment or secret manager; it is never stored in app_setting.
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
